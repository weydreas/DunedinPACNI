FROM rocker/r-ver:4.3.2
RUN Rscript -e 'install.packages("progress", repos="https://cloud.r-project.org")'
COPY DESCRIPTION NAMESPACE /opt/DunedinPACNI/
COPY R/ /opt/DunedinPACNI/R/
COPY data/ /opt/DunedinPACNI/data/
RUN R CMD INSTALL /opt/DunedinPACNI
COPY scripts/run_pacni.R /opt/pacni/run_pacni.R
